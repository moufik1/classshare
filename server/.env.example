PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de données MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/classshare?retryWrites=true&w=majority

# Authentification JWT
JWT_SECRET=super_secret_jwt_key_a_changer_en_production_123456
JWT_EXPIRES_IN=7d

# Cloudinary (pour l'étape 3 - gestion des fichiers)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
